{
  "name": "docusaurus-plugin-myog",
  "version": "0.2.0",
  "description": "Adds a MyOG.social og:image and twitter:image to every Docusaurus page, generated from each page's URL",
  "keywords": [
    "docusaurus",
    "docusaurus-plugin",
    "open-graph",
    "og-image",
    "twitter-card",
    "social-card"
  ],
  "homepage": "https://myog.social/docs/docusaurus",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MyOG-social/docusaurus-plugin-myog.git"
  },
  "bugs": {
    "url": "https://github.com/MyOG-social/docusaurus-plugin-myog/issues"
  },
  "license": "MIT",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "files": [
    "lib"
  ],
  "engines": {
    "node": ">=20.11.0"
  },
  "peerDependencies": {
    "@docusaurus/core": ">=3.10.0 <4.0.0",
    "@docusaurus/types": ">=3.10.0 <4.0.0",
    "react": "^18.0.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "@docusaurus/types": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "tsc -p tsconfig.server.json && tsc -p tsconfig.client.json",
    "prepack": "bun run build",
    "type-check": "tsc --noEmit",
    "test": "bun run build && bun test tests",
    "lint": "biome lint src tests",
    "format": "prettier --write"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.14",
    "@docusaurus/module-type-aliases": "3.10.2",
    "@docusaurus/types": "3.10.2",
    "@types/bun": "1.2.16",
    "@types/node": "24.0.0",
    "@types/react": "19.3.0",
    "prettier": "3.7.4",
    "react": "19.3.1",
    "typescript": "5.9.3"
  }
}
